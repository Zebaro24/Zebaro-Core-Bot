# Names only — real values live in .env (outside git) and in GitHub Actions secrets.
# Adding a field to src/config.py? Add it here, to docker-compose.yml and to .github/workflows/cd.yml.

# Local run: polling instead of the webhook, see src/interfaces/tg/main.py
DEBUG=True

# <--- TELEGRAM --->
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Comma-separated Telegram user ids allowed to use the Docker controls
TELEGRAM_DOCKER_ACCESS_IDS=

# <--- DISCORD --->
DISCORD_BOT_TOKEN=

# <--- GITHUB --->
PERSONAL_GITHUB_TOKEN=
PERSONAL_GITHUB_SECRET=

# Public base URL of the FastAPI server (GitHub/Telegram webhooks, /jobs/r/<id> links)
WEBHOOK_URL=

# <--- JOB SEARCHER --->
# Bearer token for /jobs/stats/weekly and /jobs/review; empty = both endpoints refuse
JOB_STATS_API_TOKEN=

# <--- OPTIONAL (defaults in src/config.py) --->
# TZ=Europe/Berlin
# SERVICES_STATE_FILE=services.json
# MONGO_URI=mongodb://localhost:27017/zebaro_core
# PLAYWRIGHT_WS_ENDPOINT=ws://localhost:9222
