# Names only — real values live in .env (outside git) and in GitHub Actions secrets.
# Adding a field to src/config.py? Add it here, to docker-compose.yml and to .github/workflows/cd.yml.

# Local run: polling instead of the webhook, see src/interfaces/tg/main.py
DEBUG=True

# <--- TELEGRAM --->
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
# Comma-separated Telegram user ids allowed to use the Docker controls
TELEGRAM_DOCKER_ACCESS_IDS=

# <--- DISCORD --->
DISCORD_BOT_TOKEN=

# <--- GITHUB --->
PERSONAL_GITHUB_TOKEN=
PERSONAL_GITHUB_SECRET=

# Public base URL of the FastAPI server (GitHub/Telegram webhooks, /jobs/r/<id> links)
WEBHOOK_URL=

# <--- JOB SEARCHER --->
# Bearer token for the Jobs API (/jobs/*, the MCP); empty = it refuses everything
JOBS_API_TOKEN=

# <--- SITE --->
# Shared secret with zebaro.dev's contact form (its CONTACT_TOKEN); empty = /site/contact refuses
SITE_CONTACT_TOKEN=

# <--- VPN (wg-easy) --->
# Admin password of wg-easy (12+ chars); compose passes it to wg-easy as INIT_PASSWORD and to
# the bot as WG_EASY_PASSWORD. The deploy stops without it rather than start an unprotected VPN.
WG_PASSWORD=
# Where clients connect: a DNS name that points straight at the server (not through Cloudflare)
# WG_HOST=server.zebaro.dev
# The owner's PC in the VPN running an HTTP proxy: Work.ua / Robota.ua / HappyMonday go through it
# (they block the server's IP). http://user:pass@10.0.0.2:8899; empty = those boards go direct.
HOME_PROXY_URL=

# <--- SPOTIFY FAMILY (Monobank) --->
# Personal API token from api.monobank.ua; empty = the service stays idle
MONOBANK_TOKEN=
# Any long random string: the webhook is /webhook/monobank/<this> (Monobank does not sign it)
MONOBANK_WEBHOOK_SECRET=
# First start sets itself up: the jar's and the card's ids (client-info) and the first charge
# MONOBANK_JAR_ID=
# MONOBANK_CARD_ID=
# SPOTIFY_SINCE=2022-08-12

# <--- OPTIONAL (defaults in src/config.py) --->
# TZ=Europe/Berlin
# SERVICES_STATE_FILE=services.json
# MONGO_URI=mongodb://localhost:27017/zebaro_core
# DATABASE_URL=sqlite+aiosqlite:///zebaro.db
# PLAYWRIGHT_WS_ENDPOINT=ws://localhost:9222
