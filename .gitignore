# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# PyTest
.pytest_cache/

# Coverage artifacts
htmlcov/
.coverage
.coverage.*
coverage.xml

# IDEs and editors
.idea/
.vscode/

# Claude Code: the shared setup (settings.json, hooks, skills, agents, docs) is versioned;
# personal overrides, one-shot push approvals and worktrees are not
.claude/settings.local.json
.claude/.approve-*
.claude/worktrees/

# Personal desk: findings that are not tasks yet, drafts, secrets
/_ideas/
/_temp/
/_secrets/

# Type checker cache
.mypy_cache/

# Browser automation snapshots and logs (Playwright MCP)
.playwright-mcp/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Local environment files
.env
.env.*
!.env.example

# Runtime state (created by ServiceManager on first toggle)
services.json
state/

# Dev version
docker-compose.override.yml
mongo_db/

# wg-easy data (keys) when the stack runs locally
/vpn/
